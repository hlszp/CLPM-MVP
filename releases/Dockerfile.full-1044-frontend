# 当前源码重新构建静态资源；复用 full-1043 的 nginx 运行时。
FROM clpm-frontend:full-1043
ARG SOURCE_REVISION
ENV APP_VERSION=v7.5.6-1044-full
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
LABEL org.opencontainers.image.version=v7.5.6-1044-full
RUN find /usr/share/nginx/html -mindepth 1 -delete
COPY --chown=nginx:nginx frontend-dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
