# 依赖与 full-1044 相同；复用已验运行时，替换全部应用源码。
FROM clpm-backend:full-1044
ARG SOURCE_REVISION
ENV APP_VERSION=v7.5.6-1045-full
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
LABEL org.opencontainers.image.version=v7.5.6-1045-full
USER root
RUN python -c "import shutil; [shutil.rmtree(p) for p in ['/app/app','/app/scripts','/app/alembic']]"
COPY --chown=1001:1001 backend/app /app/app
COPY --chown=1001:1001 backend/scripts /app/scripts
COPY --chown=1001:1001 backend/alembic /app/alembic
COPY --chown=1001:1001 backend/alembic.ini backend/pyproject.toml /app/
RUN install -d -o clpm -g clpm /app/shadow-reports
USER clpm
