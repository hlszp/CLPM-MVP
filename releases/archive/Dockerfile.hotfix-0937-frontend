#     mdi 3 / fluent-mdl2 1）从 @iconify/json 提取子集，启动时
#     addCollection 本地注册——生产浏览器访问不了 iconify 公网 CDN
#     （ERR_CONNECTION_CLOSED 拖慢整页渲染），实测五页浏览零 CDN 请求
# dist 由本地 `npm_lifecycle_script="vite build --mode clpm" pnpm exec vite
# build --mode clpm` 构建（exit=0 核验），已拷贝至 releases/frontend-dist-0937/。
FROM clpm-frontend:subpath-hotfix-0936

ENV APP_VERSION=v7.1.0-hotfix0937-icon-offline

COPY --chown=nginx:nginx releases/frontend-dist-0937/ /usr/share/nginx/html/
