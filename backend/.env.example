# Copy this file to `.env` and adjust values for your environment.
APP_NAME=CLPM
APP_VERSION=1.0.0
DEBUG=True

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clpm
POSTGRES_PASSWORD=clpm_dev_2026
POSTGRES_DB=clpm

TDENGINE_HOST=localhost
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_DB=clpm_ts

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET_KEY=clpm-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- 数据源切换 ----
# tdengine: 直接查询本地 TDengine（默认）
# remote_api: 通过外部 HistoryDataAppService API 查询
DATA_SOURCE_TYPE=tdengine

# ---- 外部历史数据 API（DATA_SOURCE_TYPE=remote_api 时生效）----
# 对接 HisDATA_API.md 规范：POST /api/services/v1/HistoryData/Get
HISTORY_DATA_API_URL=http://localhost:8100/api/services/v1/HistoryData/Get
HISTORY_DATA_API_TOKEN=
HISTORY_DATA_API_TIMEOUT=30.0

# ---- 实时数据 SignalR/WebSocket ----
# 对接 RealDATA_API.md 规范：/signalr/realValueForClpmHub
# 本地开发指向 mock_data_server；生产指向真实 SignalR Hub
SIGNALR_HUB_URL=ws://localhost:8100/signalr/realValueForClpmHub
SIGNALR_ENABLED=False
SIGNALR_RECONNECT_INTERVAL=5
