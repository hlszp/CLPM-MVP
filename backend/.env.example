# Copy this file to `.env` and adjust values for your environment.
APP_NAME=CLPM
APP_VERSION=1.0.0
DEBUG=True

POSTGRES_HOST=localhost
POSTGRES_PORT=7102
POSTGRES_USER=clpm
POSTGRES_PASSWORD=clpm_dev_2026
POSTGRES_DB=clpm

TDENGINE_HOST=localhost
TDENGINE_PORT=7104
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_DB=clpm_ts
# 批量写入批次大小（一条 INSERT SQL 插入的行数）
TDENGINE_BATCH_SIZE=1000
# 实时数据 flush 间隔（秒）
TDENGINE_FLUSH_INTERVAL=1.0

REDIS_HOST=localhost
REDIS_PORT=7103
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET_KEY=clpm-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:7103/1
CELERY_RESULT_BACKEND=redis://localhost:7103/2

# ---- 历史数据导入接口（"数据源切换"概念已废止）----
# 架构决策（2026-07-20）：计算类历史数据查询（性能评估/诊断/整定）一律走本地
# TDengine；远端历史数据接口仅"数据管理→历史数据导入"任务直接调用。
# 本配置仅作兼容保留，不再影响计算路径的数据源选择。
DATA_SOURCE_TYPE=remote_api

# ---- 网络模式（局域网/公网切换，控制 Tailscale 子网路由）----
# lan: 局域网直连（默认，生产环境）；wan: 公网走 Tailscale（调试用）
NETWORK_MODE=lan

# ---- 历史/实时数据源 URL/Token 由 sys_config 管理（UI 链路配置页 /loop/aas-sync）----
# 首次启动为空，登录后在 UI 配置一次即持久化到数据库 sys_config 表
# HISTORY_DATA_API_URL / HISTORY_DATA_API_TOKEN / SIGNALR_HUB_URL 不在此配置
HISTORY_DATA_API_TIMEOUT=120.0
SIGNALR_RECONNECT_INTERVAL=5
# SignalR 断线重连最大间隔（指数退避上限，秒）
SIGNALR_RECONNECT_MAX_INTERVAL=30

# ---- 远端 API 调用保护（防止压垮边缘 API / 服务不可用时持续施压）----
# 单进程最大并发请求数（KPI/回填/诊断共用，经 RemoteApiProvider 生效）
REMOTE_API_MAX_CONCURRENCY=4
# 连续失败达到该次数后熔断（超时/网络错误/429/5xx 计入）
REMOTE_API_CIRCUIT_FAILURES=5
# 熔断持续秒数，期间请求快速失败，到期后半开探测
REMOTE_API_CIRCUIT_OPEN_SECONDS=300.0

# SignalR 订阅默认开启，部署后自动连接数采服务器（sys_config 预载可覆盖）
SIGNALR_ENABLED=True

# 数据架构优化 Phase 1：实时数据写回本地 TDengine 宽表（taosrest 批量写入）
# 启用后实时数据持续写入本地宽表，KPI 计算从本地读取，不依赖远端 HTTP API
REALTIME_WRITEBACK_ENABLED=True

# ---- 断点续传（实时数据缺口自动补全）----
# SignalR 断线/进程重启导致的数据缺口，重连成功后自动调用远端历史数据接口补全
GAP_BACKFILL_ENABLED=False
# 小于该缺口不补（正常重连抖动，秒）；运行时经 sys_config（UI 链路配置页）调整
GAP_BACKFILL_MIN_GAP_SECONDS=600
# 单次补数最大窗口（小时，超出部分截断并告警，需手工导入）
GAP_BACKFILL_MAX_HOURS=24
