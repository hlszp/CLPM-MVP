# Copy this file to `.env` and adjust values for your environment.
APP_NAME=CLPM
APP_VERSION=1.0.0
DEBUG=True

POSTGRES_HOST=localhost
POSTGRES_PORT=7102
POSTGRES_USER=clpm
POSTGRES_PASSWORD=clpm_dev_2026
POSTGRES_DB=clpm

TDENGINE_HOST=localhost
TDENGINE_PORT=7104
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_DB=clpm_ts
# 批量写入批次大小（一条 INSERT SQL 插入的行数）
TDENGINE_BATCH_SIZE=1000
# 实时数据 flush 间隔（秒）
TDENGINE_FLUSH_INTERVAL=1.0

REDIS_HOST=localhost
REDIS_PORT=7103
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET_KEY=clpm-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:7103/1
CELERY_RESULT_BACKEND=redis://localhost:7103/2

# ---- 数据源切换 ----
# tdengine: 直接查询本地 TDengine（开发/模拟）
# remote_api: 通过外部 HistoryDataAppService API 查询（现场推荐：一 Tag 一表由底层接口对齐返回）
DATA_SOURCE_TYPE=remote_api

# ---- 外部历史数据 API（DATA_SOURCE_TYPE=remote_api 时生效）----
# 对接 HisDATA_API.md 规范：POST /api/services/v1/HistoryData/Get
HISTORY_DATA_API_URL=http://localhost:7106/api/services/v1/HistoryData/Get
HISTORY_DATA_API_TOKEN=
HISTORY_DATA_API_TIMEOUT=120.0

# ---- 实时数据 SignalR/WebSocket ----
# 对接 RealDATA_API.md 规范：/signalr/realValueForClpmHub
# 本地开发指向 mock_data_server；生产指向真实 SignalR Hub
SIGNALR_HUB_URL=ws://localhost:7106/signalr/realValueForClpmHub
SIGNALR_ENABLED=True
SIGNALR_RECONNECT_INTERVAL=5
# 数据架构优化 Phase 1：实时数据写回本地 TDengine 宽表（taosrest 批量写入）
# 启用后实时数据持续写入本地宽表，KPI 计算从本地读取，不依赖远端 HTTP API
REALTIME_WRITEBACK_ENABLED=True
