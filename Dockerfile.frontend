# syntax=docker/dockerfile:1.7
# CLPM 前端镜像 - 多阶段构建
# Builder: pnpm install + build:antd 产出 dist
# Runtime: nginx:alpine 托管静态资源并反代后端 API

# ============================================================
# Stage 1: Builder
# ============================================================
FROM node:22-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_OPTIONS=--max-old-space-size=8192 \
    TZ=Asia/Shanghai \
    CI=true

# 启用 corepack 以使用 pnpm
RUN npm config set registry https://registry.npmmirror.com \
    && npm i -g corepack@latest \
    && corepack enable

WORKDIR /app

# 拷贝整个 frontend monorepo（.dockerignore 已排除 node_modules/dist）
COPY frontend/ ./

# 安装依赖（严格按 lockfile，使用淘宝镜像加速）
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm config set registry https://registry.npmmirror.com \
    && pnpm install --frozen-lockfile

# 确保 .env.production 在 monorepo 根目录也可用（loadEnv 使用 process.cwd()，可能指向根目录）
RUN cp apps/web-antd/.env.production /app/.env.production

# 构建 web-antd 应用
WORKDIR /app/apps/web-antd
RUN pnpm vite build --mode production

# ============================================================
# Stage 2: Runtime (nginx)
# ============================================================
FROM nginx:alpine AS runtime

ENV TZ=Asia/Shanghai

# 安装 curl 用于 healthcheck
RUN apk add --no-cache curl

# 清理默认配置
RUN rm -rf /etc/nginx/conf.d/default.conf

# 拷贝自定义 nginx 配置（位于项目 deploy/nginx.conf，由 compose volume 挂载覆盖）
# 保留在镜像中作为 fallback（直接 docker run 时生效）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 拷贝前端构建产物
COPY --from=builder /app/apps/web-antd/dist /usr/share/nginx/html

# 确保 nginx 用户对静态资源可读
RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 7141

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:7141/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
