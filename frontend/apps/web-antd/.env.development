# 端口号（MVP 精简版：与原完整项目 5666 区分，首位前加 1 → 15666）
VITE_PORT=15666

VITE_BASE=/

# 接口地址（使用相对路径，通过 Vite 代理转发到后端）
VITE_GLOB_API_URL=/api/v1

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 应用名称（浏览器标题/Logo 区/登录页品牌区）
VITE_APP_TITLE=CLPM 控制回路性能评估与优化平台
