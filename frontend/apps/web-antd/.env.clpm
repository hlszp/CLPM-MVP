VITE_BASE=/clpm/

# 接口地址：子路径部署（挂在 AAS 82 端口的 /clpm/ 下）
# 外层网关用 `proxy_pass http://<前端>:7141/;`（尾斜杠剥离 /clpm/），
# 故内层 nginx 仍按 /api/v1/ 反代到后端，无需改动。
VITE_GLOB_API_URL=/clpm/api/v1

VITE_COMPRESS=none
VITE_PWA=false
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_ARCHIVER=true
VITE_SENTRY_DSN=
VITE_APP_TITLE=CLPM 控制回路性能评估与优化平台
