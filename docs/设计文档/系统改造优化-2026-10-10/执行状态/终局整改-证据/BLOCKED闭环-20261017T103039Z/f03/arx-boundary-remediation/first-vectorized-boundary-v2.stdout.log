    def identify_arx(
        u: np.ndarray,
        y: np.ndarray,
        d: int,
        na: int = 1,
        nb: int = 1,
    ) -> ARXResult:
        """ARX 辨识：y(t) + a1*y(t-1) + ... = b1*u(t-d) + ... + e(t).
    
        最小二乘解析解：theta = (Phi^T Phi)^-1 Phi^T y_reg
    
        Args:
            u: 输入信号（OP 时序）
            y: 输出信号（PV 时序）
            d: 纯滞后（采样数）
            na: A 多项式阶次
            nb: B 多项式阶次
    
        Returns:
            ARXResult
    
        Raises:
            ValueError: 数据不足或数值异常
        """
        n = len(y)
        max_lag = max(na, nb + d)
        min_samples = max_lag + 10
        if n < min_samples:
            raise ValueError(f"ARX 数据不足：{n} 点，需 ≥ {min_samples}")
    
        rows = n - max_lag
        n_params = na + nb
        Phi = np.zeros((rows, n_params))
        y_reg = np.zeros(rows)
        # 同一回归矩阵按列填充，避免时滞/不确定性扫描逐点进入 Python。
        for j in range(na):
            Phi[:, j] = -np.asarray(y[max_lag - 1 - j : n - 1 - j])
        for j in range(nb):
