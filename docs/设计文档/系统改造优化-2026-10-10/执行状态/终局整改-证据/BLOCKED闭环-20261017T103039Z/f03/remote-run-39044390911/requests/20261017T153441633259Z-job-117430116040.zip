2026-10-17T15:32:27.8600555Z 
2026-10-17T15:32:27.8600736Z     def test_joint_annotation_snr_matches_independent_recompute(self):
2026-10-17T15:32:27.8601244Z         """记录的 snrDb 与测试侧独立重算一致（±0.2dB；口径=ΣS/ΣN 聚合）."""
2026-10-17T15:32:27.8601535Z         result = self._run()
2026-10-17T15:32:27.8601795Z         assert result.success, result.reason
2026-10-17T15:32:27.8602091Z         ev = result.best_model.evidence
2026-10-17T15:32:27.8602419Z         assert ev is not None and ev.low_snr is not None
2026-10-17T15:32:27.8602786Z         mw = (result.preprocessing or {}).get("multiWindow") or {}
2026-10-17T15:32:27.8603175Z         segs = (mw.get("jointEstimate") or {}).get("segments") or []
2026-10-17T15:32:27.8603563Z         assert segs, "joint 胜出应记录段块信息"
2026-10-17T15:32:27.8603890Z         # 用快照保存前的全量输入重切段（构造确定性——同种子重生成）
2026-10-17T15:32:27.8604203Z         op, pv = _two_segments_fopdt(self.NOISE, 700, self.SEED)
2026-10-17T15:32:27.8604646Z         ref = _independent_joint_snr_db([pv[s["start"] : s["end"]] for s in segs], 1.0)
2026-10-17T15:32:27.8605059Z         assert ref is not None
2026-10-17T15:32:27.8605329Z >       assert abs(ev.low_snr["snrDb"] - ref) <= 0.2, (
2026-10-17T15:32:27.8605713Z             f"记录 {ev.low_snr['snrDb']} vs 独立重算 {ref:.2f}"
2026-10-17T15:32:27.8605988Z         )
