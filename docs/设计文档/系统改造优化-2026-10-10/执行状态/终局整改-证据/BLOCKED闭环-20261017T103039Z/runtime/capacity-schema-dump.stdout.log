--
-- Name: mv_diagnosis_pareto; Type: MATERIALIZED VIEW; Schema: public; Owner: -
--

CREATE MATERIALIZED VIEW public.mv_diagnosis_pareto AS
 SELECT
        CASE primary_category
            WHEN 'TUNING'::text THEN '参数问题（PID 整定）'::character varying
            WHEN 'VALVE'::text THEN '阀门/执行机构问题'::character varying
            WHEN 'INSTRUMENT'::text THEN '仪表/测量问题'::character varying
            WHEN 'COMMUNICATION'::text THEN '通信链路问题'::character varying
            WHEN 'PROCESS'::text THEN '工艺/外扰问题'::character varying
            WHEN 'UTILIZATION'::text THEN '投用/操作问题'::character varying
            WHEN 'DESIGN'::text THEN '组态/设计问题'::character varying
            WHEN 'DATA_INSUFFICIENT'::text THEN '数据不足/无法判定'::character varying
            ELSE primary_category
        END AS root_cause,
    count(*) AS tag_count,
    count(*) FILTER (WHERE (EXISTS ( SELECT 1
           FROM public.loop_action_item a
          WHERE ((a.run_id = r.id) AND (a.converted_order_id IS NOT NULL))))) AS converted_count,
    count(*) FILTER (WHERE (EXISTS ( SELECT 1
           FROM public.loop_action_item a
          WHERE ((a.run_id = r.id) AND ((a.status)::text = 'IGNORED'::text))))) AS ignored_count,
    (0)::bigint AS sla_warned_count
   FROM public.diagnosis_run r
  WHERE (((status)::text = 'SUCCESS'::text) AND (primary_category IS NOT NULL) AND (created_at >= ((now() AT TIME ZONE 'utc'::text) - '30 days'::interval)))
  GROUP BY primary_category
  WITH NO DATA;


--
-- Name: mv_handling_funnel; Type: MATERIALIZED VIEW; Schema: public; Owner: -
--

CREATE MATERIALIZED VIEW public.mv_handling_funnel AS
 SELECT COALESCE(scope_type, 'GLOBAL'::character varying) AS scope_type,
    COALESCE(scope_id, 0) AS scope_id,
    count(*) AS total_count,
    count(*) FILTER (WHERE ((status)::text = 'PENDING'::text)) AS pending_count,
    count(*) FILTER (WHERE ((status)::text = 'EXECUTING'::text)) AS executing_count,
    count(*) FILTER (WHERE ((status)::text = 'VERIFYING'::text)) AS verifying_count,
    count(*) FILTER (WHERE ((status)::text = 'CLOSED'::text)) AS closed_count,
    count(*) FILTER (WHERE ((status)::text = 'REOPENED'::text)) AS reopened_count,
    count(*) FILTER (WHERE ((status)::text = 'CANCELLED'::text)) AS cancelled_count,
    count(*) FILTER (WHERE ((sla_stage)::text = 'BREACH'::text)) AS breached_count,
    avg(
        CASE
            WHEN ((status)::text = 'CLOSED'::text) THEN (EXTRACT(epoch FROM (COALESCE(verified_at, updated_at) - created_at)) / (3600)::numeric)
            ELSE NULL::numeric
        END) AS avg_cycle_hours
   FROM public.handling_order h
  GROUP BY COALESCE(scope_type, 'GLOBAL'::character varying), COALESCE(scope_id, 0)
  WITH NO DATA;


