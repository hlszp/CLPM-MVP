-- Name: handling_order; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.handling_order (
    id uuid NOT NULL,
    order_no character varying(32) NOT NULL,
    loop_id uuid NOT NULL,
    source character varying(16) NOT NULL,
    suggestion_ids jsonb,
    title character varying(200) NOT NULL,
    action_type character varying(16) NOT NULL,
    action_detail jsonb,
    planned_at timestamp without time zone,
    planned_by character varying(64),
    handler character varying(64),
    started_at timestamp without time zone,
    feedback_log jsonb,
    submitted_at timestamp without time zone,
    verify_run_id uuid,
    verify_result character varying(16),
    verify_note character varying(500),
    verified_by character varying(64),
    verified_at timestamp without time zone,
    kpi_before jsonb,
    kpi_after jsonb,
    tuning_record_id uuid,
    cancel_reason character varying(200),
    status character varying(16) DEFAULT 'PENDING'::character varying NOT NULL,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    sla_policy_id bigint,
    sla_deadline_at timestamp without time zone,
    sla_stage character varying(8) DEFAULT 'NONE'::character varying NOT NULL,
    reopen_count integer DEFAULT 0 NOT NULL,
    reopen_reasons jsonb DEFAULT '[]'::jsonb NOT NULL,
    scope_type character varying(16),
    scope_id integer,
    handler_id uuid,
    implemented_at timestamp without time zone,
    closure_evidence character varying(32),
    actual_rollback_confirmed boolean DEFAULT false NOT NULL,
    rollback_confirmed_at timestamp without time zone,
    rollback_confirmed_by character varying(64),
    rollback_note character varying(200),
    CONSTRAINT ck_handling_order_action_type CHECK (((action_type)::text = ANY ((ARRAY['TUNING'::character varying, 'VALVE'::character varying, 'INSTRUMENT'::character varying, 'LINK'::character varying, 'PROCESS'::character varying, 'UTILIZATION'::character varying, 'RECONFIG'::character varying, 'OTHER'::character varying])::text[]))),
    CONSTRAINT ck_handling_order_closure_evidence CHECK (((closure_evidence IS NULL) OR ((closure_evidence)::text = ANY ((ARRAY['MANUAL_CONFIRMATION'::character varying, 'DATA_VERIFIED'::character varying, 'COMPARABLE_CONDITION_VERIFIED'::character varying])::text[])))),
    CONSTRAINT ck_handling_order_reopen_nonneg CHECK ((reopen_count >= 0)),
    CONSTRAINT ck_handling_order_sla_stage CHECK (((sla_stage)::text = ANY ((ARRAY['NONE'::character varying, 'WARN'::character varying, 'BREACH'::character varying])::text[]))),
    CONSTRAINT ck_handling_order_source CHECK (((source)::text = ANY ((ARRAY['DIAGNOSIS'::character varying, 'MANUAL'::character varying])::text[]))),
    CONSTRAINT ck_handling_order_status CHECK (((status)::text = ANY ((ARRAY['PENDING'::character varying, 'EXECUTING'::character varying, 'VERIFYING'::character varying, 'CLOSED'::character varying, 'REOPENED'::character varying, 'CANCELLED'::character varying])::text[]))),
    CONSTRAINT ck_handling_order_verify_result CHECK (((verify_result IS NULL) OR ((verify_result)::text = ANY ((ARRAY['EFFECTIVE'::character varying, 'INEFFECTIVE'::character varying])::text[]))))
);


