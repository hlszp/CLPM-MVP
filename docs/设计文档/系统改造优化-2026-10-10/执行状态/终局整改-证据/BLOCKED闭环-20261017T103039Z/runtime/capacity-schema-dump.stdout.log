--
-- Name: loop_investigation; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.loop_investigation (
    id uuid NOT NULL,
    loop_id uuid NOT NULL,
    source_kind character varying(32) NOT NULL,
    source_id character varying(64) NOT NULL,
    problem_key character varying(128) NOT NULL,
    title character varying(200) NOT NULL,
    detail character varying(500),
    stage character varying(16) DEFAULT 'TODO'::character varying NOT NULL,
    outcome character varying(24),
    outcome_note character varying(500),
    owner_id uuid,
    owner_name character varying(100),
    wait_reason character varying(200),
    wait_review_condition character varying(200),
    wait_responsible character varying(120),
    close_target_kind character varying(32),
    close_target_id character varying(64),
    handoff_source_id uuid,
    revision integer NOT NULL,
    last_request_id character varying(64),
    created_by uuid,
    closed_by uuid,
    closed_at timestamp without time zone,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    CONSTRAINT ck_loop_investigation_handoff_target CHECK (((outcome IS NULL) OR ((outcome)::text <> 'HANDED_OFF'::text) OR (((close_target_kind)::text = 'loop_investigation'::text) AND (close_target_id IS NOT NULL)))),
    CONSTRAINT ck_loop_investigation_outcome CHECK (((((stage)::text = 'CLOSED'::text) AND (outcome IS NOT NULL) AND ((outcome)::text = ANY ((ARRAY['NO_FURTHER_ACTION'::character varying, 'ANSWERED'::character varying, 'HANDED_OFF'::character varying, 'CANCELLED'::character varying])::text[])) AND (closed_at IS NOT NULL)) OR (((stage)::text <> 'CLOSED'::text) AND (outcome IS NULL) AND (closed_at IS NULL)))),
    CONSTRAINT ck_loop_investigation_revision CHECK ((revision >= 1)),
    CONSTRAINT ck_loop_investigation_stage CHECK (((stage)::text = ANY ((ARRAY['TODO'::character varying, 'IN_PROGRESS'::character varying, 'WAITING'::character varying, 'CLOSED'::character varying])::text[]))),
    CONSTRAINT ck_loop_investigation_waiting CHECK (((((stage)::text = 'WAITING'::text) AND (wait_reason IS NOT NULL) AND (wait_review_condition IS NOT NULL) AND (wait_responsible IS NOT NULL)) OR (((stage)::text <> 'WAITING'::text) AND (wait_reason IS NULL) AND (wait_review_condition IS NULL) AND (wait_responsible IS NULL))))
);


--
-- Name: loop_ledger; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.loop_ledger (
    id uuid DEFAULT public.uuid_generate_v4() NOT NULL,
    tag_name character varying(100) NOT NULL,
    description character varying(255),
    unit_id uuid,
    score_weight numeric(5,2),
    is_active boolean DEFAULT true,
    last_aas_sync_at timestamp without time zone,
    status character varying(20) DEFAULT 'PARTIAL'::character varying NOT NULL,
    loop_type character varying(20) DEFAULT 'OTHER'::character varying,
    control_type character varying(20),
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    created_by character varying(50),
    score_weights jsonb,
    remark character varying(500),
    updated_by character varying(50),
    importance_level smallint DEFAULT 2 NOT NULL,
    include_in_evaluation boolean DEFAULT true NOT NULL,
    modeattr_tag_id uuid,
    data_retention_days integer,
    op_output_lower_limit double precision,
    op_output_upper_limit double precision,
    dcs_model_id uuid,
    ideal_settling_time double precision,
    complex_loop_group_id uuid,
    complex_role character varying(10),
    control_action_direction character varying(16) DEFAULT 'UNKNOWN'::character varying NOT NULL,
    engineering_template_id uuid,
    engineering_template_version integer,
    CONSTRAINT ck_loop_ledger_complex_group_coherence CHECK ((((complex_loop_group_id IS NULL) AND (complex_role IS NULL)) OR ((complex_loop_group_id IS NOT NULL) AND (complex_role IS NOT NULL)))),
    CONSTRAINT ck_loop_ledger_complex_role CHECK (((complex_role IS NULL) OR ((complex_role)::text = ANY ((ARRAY['MAIN'::character varying, 'SUB'::character varying])::text[])))),
    CONSTRAINT ck_loop_ledger_control_action_direction CHECK (((control_action_direction)::text = ANY ((ARRAY['DIRECT'::character varying, 'REVERSE'::character varying, 'UNKNOWN'::character varying])::text[]))),
    CONSTRAINT ck_loop_ledger_importance_level CHECK ((importance_level = ANY (ARRAY[1, 2, 3]))),
    CONSTRAINT ck_loop_ledger_status CHECK (((status)::text = ANY ((ARRAY['READY'::character varying, 'PARTIAL'::character varying, 'INACTIVE'::character varying])::text[])))
);


