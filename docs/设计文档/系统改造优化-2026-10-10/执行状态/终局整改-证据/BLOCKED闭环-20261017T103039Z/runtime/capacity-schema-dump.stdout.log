-- Name: tuning_record; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.tuning_record (
    id uuid DEFAULT public.uuid_generate_v4() NOT NULL,
    loop_id uuid NOT NULL,
    model_type character varying(20) NOT NULL,
    model_params json,
    algorithm character varying(50) NOT NULL,
    recommended_pid json,
    simulation_result json,
    fitting_score numeric(5,2),
    status character varying(20) NOT NULL,
    created_by character varying(50),
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    identify_method character varying(30),
    data_source character varying(20),
    time_window_start timestamp without time zone,
    time_window_end timestamp without time zone,
    confidence_level character varying(12),
    confidence_reason character varying(200),
    excitation_score numeric(5,2),
    residual_test_passed boolean,
    pid_candidates json,
    candidate_results json,
    task_id character varying(64),
    completed_at timestamp without time zone,
    process_model_version_id uuid,
    current_pid json,
    risk_assessment json,
    rollback_pid json,
    dataset_snapshot_id uuid,
    source_record_id uuid,
    dcs_template_revision character varying(64),
    calc_context json,
    CONSTRAINT ck_tuning_record_algo CHECK (((algorithm)::text = ANY ((ARRAY['IMC'::character varying, 'LAMBDA'::character varying, 'ZN'::character varying, 'COHEN_COON'::character varying, 'SIMC'::character varying, 'IDENTIFICATION_ONLY'::character varying, 'MANUAL_TUNING'::character varying])::text[]))),
    CONSTRAINT ck_tuning_record_data_source CHECK (((data_source IS NULL) OR ((data_source)::text = ANY ((ARRAY['HISTORY'::character varying, 'STEP_EXPERIMENT'::character varying, 'fallback_step'::character varying])::text[])))),
    CONSTRAINT ck_tuning_record_identify_method CHECK (((identify_method IS NULL) OR ((identify_method)::text = ANY ((ARRAY['HISTORICAL_ARX'::character varying, 'HISTORICAL_ARMAX'::character varying, 'HISTORICAL_IV'::character varying, 'STEP_TWO_POINT'::character varying, 'STEP_AREA'::character varying, 'STEP_NLS'::character varying])::text[])))),
    CONSTRAINT ck_tuning_record_model CHECK (((model_type)::text = ANY ((ARRAY['FOPDT'::character varying, 'SOPDT'::character varying, 'IPDT'::character varying])::text[]))),
    CONSTRAINT ck_tuning_record_status CHECK (((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'RUNNING'::character varying, 'IDENTIFIED'::character varying, 'SIMULATED'::character varying, 'COMPLETED'::character varying, 'INCONCLUSIVE'::character varying, 'ROLLED_BACK'::character varying, 'PENDING'::character varying, 'APPLIED'::character varying, 'VERIFIED'::character varying])::text[])))
);


