--

CREATE TABLE public.process_model_version (
    id uuid DEFAULT public.uuid_generate_v4() NOT NULL,
    loop_id uuid NOT NULL,
    version integer NOT NULL,
    status character varying(12) DEFAULT 'CANDIDATE'::character varying NOT NULL,
    data_window_start timestamp without time zone,
    data_window_end timestamp without time zone,
    data_hash character varying(64),
    condition_summary json,
    algorithm_version character varying(50),
    identify_method character varying(30),
    model_type character varying(20) NOT NULL,
    model_params json,
    theta_source character varying(20),
    sampling_period double precision,
    metrics json,
    residual_test json,
    uncertainty json,
    physical_feasibility json,
    confidence_level character varying(12),
    confidence_reason character varying(500),
    published_by character varying(50),
    published_at timestamp without time zone,
    supersedes_version_id uuid,
    retired_reason character varying(500),
    retired_at timestamp without time zone,
    retired_by character varying(50),
    created_by character varying(50),
    created_at timestamp without time zone DEFAULT (now() AT TIME ZONE 'UTC'::text) NOT NULL,
    dataset_snapshot_id uuid,
    CONSTRAINT ck_process_model_version_confidence CHECK (((confidence_level IS NULL) OR ((confidence_level)::text = ANY ((ARRAY['A'::character varying, 'B'::character varying, 'C'::character varying, 'D'::character varying, 'E'::character varying, 'INCONCLUSIVE'::character varying])::text[])))),
    CONSTRAINT ck_process_model_version_identify_method CHECK (((identify_method IS NULL) OR ((identify_method)::text = ANY ((ARRAY['HISTORICAL_ARX'::character varying, 'HISTORICAL_ARMAX'::character varying, 'HISTORICAL_IV'::character varying, 'STEP_TWO_POINT'::character varying, 'STEP_AREA'::character varying, 'STEP_NLS'::character varying])::text[])))),
    CONSTRAINT ck_process_model_version_model_type CHECK (((model_type)::text = ANY ((ARRAY['FOPDT'::character varying, 'SOPDT'::character varying, 'IPDT'::character varying])::text[]))),
    CONSTRAINT ck_process_model_version_status CHECK (((status)::text = ANY ((ARRAY['CANDIDATE'::character varying, 'CURRENT'::character varying, 'RETIRED'::character varying])::text[]))),
    CONSTRAINT ck_process_model_version_theta_source CHECK (((theta_source IS NULL) OR ((theta_source)::text = ANY ((ARRAY['EXPLICIT'::character varying, 'SEARCHED'::character varying, 'HEURISTIC_2TS'::character varying])::text[]))))
);


