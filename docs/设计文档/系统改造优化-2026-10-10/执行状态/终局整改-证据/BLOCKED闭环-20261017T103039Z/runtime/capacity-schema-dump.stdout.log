CREATE TABLE public.loop_action_item (
    id uuid NOT NULL,
    run_id uuid,
    loop_id uuid NOT NULL,
    source character varying(8) DEFAULT 'SYSTEM'::character varying NOT NULL,
    category character varying(32),
    content text NOT NULL,
    basis character varying(500),
    priority integer,
    status character varying(16) DEFAULT 'PENDING'::character varying NOT NULL,
    suggested_by character varying(64) NOT NULL,
    suggested_at timestamp without time zone NOT NULL,
    reviewed_by character varying(64),
    reviewed_at timestamp without time zone,
    rejected_reason character varying(200),
    converted_order_id uuid,
    ignore_reason character varying(200),
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    CONSTRAINT ck_loop_action_item_category CHECK (((category IS NULL) OR ((category)::text = ANY ((ARRAY['TUNING'::character varying, 'VALVE'::character varying, 'INSTRUMENT'::character varying, 'COMMUNICATION'::character varying, 'PROCESS'::character varying, 'UTILIZATION'::character varying, 'DESIGN'::character varying, 'DATA_INSUFFICIENT'::character varying])::text[])))),
    CONSTRAINT ck_loop_action_item_source CHECK (((source)::text = ANY ((ARRAY['SYSTEM'::character varying, 'MANUAL'::character varying])::text[]))),
    CONSTRAINT ck_loop_action_item_status CHECK (((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'CONVERTED'::character varying, 'REJECTED'::character varying, 'IGNORED'::character varying])::text[])))
);


