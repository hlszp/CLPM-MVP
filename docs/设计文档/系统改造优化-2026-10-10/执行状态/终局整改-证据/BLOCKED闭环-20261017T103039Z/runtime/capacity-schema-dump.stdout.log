--
-- Name: mv_staff_workload; Type: MATERIALIZED VIEW; Schema: public; Owner: -
--

CREATE MATERIALIZED VIEW public.mv_staff_workload AS
 SELECT h.handler_id AS user_id,
    u.display_name AS user_name,
    count(*) FILTER (WHERE ((h.status)::text = ANY ((ARRAY['PENDING'::character varying, 'EXECUTING'::character varying, 'VERIFYING'::character varying])::text[]))) AS active_count,
    count(*) FILTER (WHERE ((h.status)::text = 'PENDING'::text)) AS pending_count,
    count(*) FILTER (WHERE ((h.status)::text = 'EXECUTING'::text)) AS executing_count,
    count(*) FILTER (WHERE ((h.status)::text = 'VERIFYING'::text)) AS verifying_count,
    count(*) FILTER (WHERE ((h.sla_stage)::text = ANY ((ARRAY['WARN'::character varying, 'BREACH'::character varying])::text[]))) AS sla_warned_count,
    count(*) FILTER (WHERE ((h.status)::text = 'CLOSED'::text)) AS closed_count,
    max(h.updated_at) AS last_activity_at
   FROM (public.handling_order h
     LEFT JOIN public.sys_user u ON ((u.id = h.handler_id)))
  WHERE (h.handler_id IS NOT NULL)
  GROUP BY h.handler_id, u.display_name
  WITH NO DATA;


