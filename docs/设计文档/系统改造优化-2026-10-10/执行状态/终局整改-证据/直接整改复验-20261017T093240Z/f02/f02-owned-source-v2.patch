+async def test_settled_gather_preserves_result_order():
+    done = asyncio.Event()
+
+    async def first():
+        await done.wait()
+        return "first"
+
+    async def second():
+        done.set()
+        return "second"
+
+    assert await gather_settled(first(), second()) == ["first", "second"]
+
