+async def test_cancelled_provider_is_neither_retried_nor_failed_record(
+    monkeypatch, batch_boundaries
+):
+    _, append_failed, sleep = batch_boundaries
+    calc = AsyncMock(side_effect=asyncio.CancelledError())
