   backend-ci:
     name: Backend CI
@@ -174,3 +175,133 @@ jobs:
           POSTGRES_PASSWORD: clpm_ci_only_2026
           POSTGRES_DB: clpm
         run: uv run pytest --cov=app --cov-report=term-missing --cov-fail-under=60
+
+  critical-e2e:
+    name: Critical E2E Gate (blocking)
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    needs: backend-ci
+    services:
+      redis:
+        image: redis:7-alpine
+        ports:
+          - 6379:6379
+        options: >-
+          --health-cmd "redis-cli ping"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+      postgres:
+        image: postgres:16
+        env:
+          POSTGRES_USER: clpm
+          POSTGRES_PASSWORD: clpm_ci_only_2026
+          POSTGRES_DB: clpm
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U clpm -d clpm"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      # ---- Backend setup ----
+      - name: Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install uv
+        uses: astral-sh/setup-uv@v3
+        with:
+          enable-cache: true
+          cache-dependency-glob: backend/uv.lock
+
+      - name: Sync backend dependencies
+        working-directory: backend
+        run: uv sync --frozen
+
+      - name: Apply bootstrap SQL + stamp
+        working-directory: backend
+        env:
+          POSTGRES_HOST: localhost
+          POSTGRES_PORT: "5432"
+          POSTGRES_USER: clpm
+          POSTGRES_PASSWORD: clpm_ci_only_2026
+          POSTGRES_DB: clpm
+          JWT_SECRET_KEY: ci-test-secret-key-at-least-32-characters-long!!!
+        run: |
+          uv run python scripts/apply_bootstrap_sql.py
+          uv run alembic stamp head
+
+      - name: Start backend
+        working-directory: backend
+        env:
+          POSTGRES_HOST: localhost
+          POSTGRES_PORT: "5432"
+          POSTGRES_USER: clpm
+          POSTGRES_PASSWORD: clpm_ci_only_2026
+          POSTGRES_DB: clpm
+          JWT_SECRET_KEY: ci-test-secret-key-at-least-32-characters-long!!!
+          REDIS_HOST: localhost
+          REDIS_PORT: "6379"
+        run: |
+          uv run uvicorn app.main:app --host 0.0.0.0 --port 17101 &
+          echo $! > /tmp/backend.pid
+          for i in $(seq 1 30); do
+            curl -sf http://localhost:17101/health && break
+            sleep 2
+          done
+          curl -sf http://localhost:17101/health
+
+      # ---- Frontend setup ----
+      - name: Install pnpm
+        uses: pnpm/action-setup@v4
+        with:
+          version: 10
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: pnpm
+          cache-dependency-path: frontend/pnpm-lock.yaml
+
+      - name: Install frontend dependencies
+        working-directory: frontend
+        run: pnpm install --frozen-lockfile
+
+      - name: Build frontend
+        working-directory: frontend
+        run: pnpm build:antd
+
+      - name: Start frontend preview
+        working-directory: frontend
+        run: |
+          pnpm -F @vben/web-antd preview --port 15666 &
+          echo $! > /tmp/frontend.pid
+          for i in $(seq 1 30); do
+            curl -sf http://localhost:15666 && break
+            sleep 2
+          done
+
+      # ---- Critical E2E gate ----
+      - name: Install Playwright browsers
+        run: npx playwright install --with-deps chromium
+        working-directory: e2e
+
+      - name: Run critical E2E gate (blocking)
+        run: bash scripts/run-critical-e2e.sh
+        env:
+          E2E_BASE_URL: http://localhost:15666
+          E2E_API_BASE_URL: http://localhost:17101
+
+      - name: Cleanup
+        if: always()
+        run: |
+          kill $(cat /tmp/backend.pid) 2>/dev/null || true
+          kill $(cat /tmp/frontend.pid) 2>/dev/null || true
