{
  "continue_on_error_fields": [
    {
      "path": "/jobs/backend-ci/steps/7",
      "value": true
    }
  ],
  "critical_job_steps": [
    {
      "name": "Checkout code",
      "working-directory": null,
      "run": null
    },
    {
      "name": "Setup Python",
      "working-directory": null,
      "run": null
    },
    {
      "name": "Install uv",
      "working-directory": null,
      "run": null
    },
    {
      "name": "Sync backend dependencies",
      "working-directory": "backend",
      "run": "uv sync --frozen"
    },
    {
      "name": "Apply bootstrap SQL + stamp",
      "working-directory": "backend",
      "run": "uv run python scripts/apply_bootstrap_sql.py\nuv run alembic stamp head\n"
    },
    {
      "name": "Start backend",
      "working-directory": "backend",
      "run": "uv run uvicorn app.main:app --host 0.0.0.0 --port 17101 &\necho $! > /tmp/backend.pid\nfor i in $(seq 1 30); do\n  curl -sf http://localhost:17101/health && break\n  sleep 2\ndone\ncurl -sf http://localhost:17101/health\n"
    },
    {
      "name": "Install pnpm",
      "working-directory": null,
      "run": null
    },
    {
      "name": "Setup Node.js",
      "working-directory": null,
      "run": null
    },
    {
      "name": "Install frontend dependencies",
      "working-directory": "frontend",
      "run": "pnpm install --frozen-lockfile"
    },
    {
      "name": "Build frontend",
      "working-directory": "frontend",
      "run": "pnpm build:antd"
    },
    {
      "name": "Start frontend preview",
      "working-directory": "frontend",
      "run": "pnpm -F @vben/web-antd preview --port 15666 &\necho $! > /tmp/frontend.pid\nfor i in $(seq 1 30); do\n  curl -sf http://localhost:15666 && break\n  sleep 2\ndone\n"
    },
    {
      "name": "Install Playwright browsers",
      "working-directory": "e2e",
      "run": "npx playwright install --with-deps chromium"
    },
    {
      "name": "Run critical E2E gate (blocking)",
      "working-directory": null,
      "run": "bash scripts/run-critical-e2e.sh"
    },
    {
      "name": "Cleanup",
      "working-directory": null,
      "run": "kill $(cat /tmp/backend.pid) 2>/dev/null || true\nkill $(cat /tmp/frontend.pid) 2>/dev/null || true\n"
    }
  ]
}
