+        assert report["parentTaskId"] == PARENT
+        assert report["gate"]["denominators"]["frozenEligible"] == 2
+        assert report["sloPassed"] is (outcome == "pending_then_pass")
+        if outcome in {"mismatch", "parent_failed"}:
