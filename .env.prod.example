# ============================================================
# CLPM 生产环境配置模板
# 使用方法：
#   1. cp .env.prod.example .env.prod
#   2. 修改所有 <change-me-...> 占位符为真实值
#   3. 生成 JWT 密钥：openssl rand -hex 32
# ============================================================

# ---- Application ----
APP_NAME=CLPM
APP_VERSION=1.0.0
DEBUG=False

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=clpm
POSTGRES_PASSWORD=<change-me-in-production>
POSTGRES_DB=clpm

# ---- TDengine ----
TDENGINE_HOST=tdengine
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=<change-me-in-production>
TDENGINE_DB=clpm_ts

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- JWT（生产环境必须设置独立密钥，至少 32 字符）----
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- AAS (OPC UA) ----
AAS_ENDPOINT=opc.tcp://opcua-server:4840
AAS_MOCK_MODE=False
AAS_SYNC_INTERVAL_SECONDS=300
AAS_SYNC_ENABLED=True
AAS_SECURITY_MODE=None

# ---- CORS（生产环境使用实际域名）----
CORS_ORIGINS=["https://your-domain.com"]
