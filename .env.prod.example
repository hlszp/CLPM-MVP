# ============================================================
# CLPM 生产环境配置模板
# 使用方法：
#   1. cp .env.prod.example .env.prod
#   2. 修改所有 <change-me-...> 占位符为真实值
#   3. 生成 JWT 密钥：openssl rand -hex 32
# ============================================================

# ---- Application ----
APP_NAME=CLPM
APP_VERSION=1.0.0
ENV=production
DEBUG=False

# ---- PostgreSQL ----
# 容器间连接使用 PostgreSQL 内部端口（生产 Compose 不映射到宿主机）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=clpm
POSTGRES_PASSWORD=<change-me-in-production>
POSTGRES_DB=clpm

# ---- TDengine（仅 DATA_SOURCE_TYPE=tdengine 时需要）----
# deploy.sh 会自动启用 tdengine profile；remote_api 模式不启动内置 TDengine。
# 内置镜像使用 3.3.6.6，通过 TAOS_ROOT_PASSWORD 将此密码应用到 root 账号。
# 对接外部 TDengine 时，将 HOST/PORT/USER/PASSWORD 改为已预初始化实例的凭据。
TDENGINE_HOST=tdengine
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=<change-me-in-production>
TDENGINE_DB=clpm_ts

# ---- Redis ----
# 容器间连接使用 Redis 内部端口（生产 Compose 不映射到宿主机）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<change-me-in-production>
REDIS_DB=0

# ---- JWT（生产环境必须设置独立密钥，至少 32 字符）----
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Celery（不显式配置 URL，由 config.py 自动从 REDIS_HOST/PORT/PASSWORD 构造带密码的 URL）----
# worker 进程数：与 docker-compose.prod.yml 中 worker cpus 限额匹配，按宿主机核数调整（回填任务每子任务约吃 1 核）

CELERY_WORKER_CONCURRENCY=8

# ---- AAS (OPC UA) ----
AAS_ENDPOINT=opc.tcp://<industrial-opcua-server>:4840
AAS_MOCK_MODE=False
AAS_SYNC_INTERVAL_SECONDS=300
AAS_SYNC_ENABLED=True
AAS_SECURITY_MODE=SignAndEncrypt

# ---- CORS（__AUTO__ 由 deploy.sh 部署时自动替换为本机 IP）----
# 如需额外来源（域名、其他 IP），追加到数组中即可
CORS_ORIGINS=["__AUTO__", "http://localhost:7141"]

# ---- 数据源切换 ----
# tdengine: 直接查询本地 TDengine（适用于 TDengine 部署在同机房场景）
# remote_api: 通过外部 HistoryDataAppService API 查询（适用于对接工控数采系统场景）
# 生产环境默认使用 remote_api（对接工控数采系统）
DATA_SOURCE_TYPE=remote_api

# ---- 外部历史数据 API（DATA_SOURCE_TYPE=remote_api 时必须配置）----
# 对接 HisDATA_API.md 规范：POST /api/services/v1/HistoryData/Get
# 生产环境替换为工控数采系统提供的真实地址
HISTORY_DATA_API_URL=http://<industrial-data-server>/api/services/v1/HistoryData/Get
HISTORY_DATA_API_TOKEN=<change-me-or-leave-empty-if-no-auth>
HISTORY_DATA_API_TIMEOUT=30.0

# ---- 实时数据 SignalR/WebSocket ----
# 对接 RealDATA_API.md 规范：/signalr/realValueForClpmHub
# 生产环境替换为工控数采系统提供的真实 SignalR Hub 地址
SIGNALR_HUB_URL=ws://<industrial-data-server>/signalr/realValueForClpmHub
SIGNALR_ENABLED=False
SIGNALR_RECONNECT_INTERVAL=5

# ---- 实时数据写回 TDengine（仅 DATA_SOURCE_TYPE=tdengine 模式生效）----
# 开启后实时推送的值将写回本地 TDengine 宽表，适用于开发/模拟场景
# 生产现场模式（数据已由外部系统存储）建议保持 False
REALTIME_WRITEBACK_ENABLED=False
